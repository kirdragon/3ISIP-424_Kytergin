<Page x:Class="WpfApp10.Pages.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Дополнительные опции">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Выберите цвет автомобиля:"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,10,0,10"/>

            <ComboBox x:Name="ColorComboBox"
                      Height="35"
                      FontSize="15"/>

            <TextBlock Text="Дополнительные опции:"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,30,0,10"/>

            <StackPanel x:Name="OptionsPanel"/>

        </StackPanel>
    </ScrollViewer>
</Page>