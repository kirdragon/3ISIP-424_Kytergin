<Page x:Class="WpfApp10.Pages.PricePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Стоимость автомобиля">

    <StackPanel Margin="20">

        <TextBlock Text="Расчёт стоимости автомобиля"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,10,0,25"/>

        <TextBlock x:Name="CarText"
                   FontSize="16"
                   Margin="5"/>

        <TextBlock x:Name="EngineText"
                   FontSize="16"
                   Margin="5"/>

        <TextBlock x:Name="ColorText"
                   FontSize="16"
                   Margin="5"/>

        <TextBlock x:Name="OptionsText"
                   FontSize="16"
                   Margin="5"/>

        <Separator Margin="5,20"/>

        <TextBlock x:Name="TotalPriceText"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="5"/>

    </StackPanel>
</Page>