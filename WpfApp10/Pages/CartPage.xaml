<Page x:Class="WpfApp10.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина">

    <StackPanel Margin="15">
        <TextBlock Text="Корзина"
                   FontSize="20"
                   Margin="0,0,0,10"/>

        <DataGrid x:Name="CartGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Height="330">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding Product.Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Product.Price}"
                                    Width="100"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Sum}"
                                    Width="100"/>

                <DataGridTemplateColumn Header="Количество"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="+"
                                        Width="30"
                                        Click="Increase_Click"/>

                                <Button Content="-"
                                        Width="30"
                                        Margin="5,0,0,0"
                                        Click="Decrease_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Удалить"
                                        Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                                    Click="Remove_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalText"
                   Text="Итого: 0"
                   FontSize="18"
                   Margin="0,15,0,10"/>

        <Button Content="Очистить корзину"
                Width="150"
                HorizontalAlignment="Left"
                Click="ClearCart_Click"/>
    </StackPanel>
</Page>
