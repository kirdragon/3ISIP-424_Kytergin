<Page x:Class="WpfApp10.Pages.LoanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Автокредит">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">
            <StackPanel>

                <TextBlock Text="Условия автокредита"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="5,5,5,20"/>

                <TextBlock Text="Первоначальный взнос:"
                           FontSize="15"
                           Margin="5"/>

                <Slider x:Name="DownPaymentSlider"
                        Minimum="10"
                        Maximum="90"
                        Value="20"
                        TickFrequency="10"
                        IsSnapToTickEnabled="True"
                        Margin="5"/>

                <TextBlock x:Name="DownPaymentText"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="5,5,5,20"/>

                <TextBlock Text="Срок кредита:"
                           FontSize="15"
                           Margin="5"/>

                <ComboBox x:Name="LoanMonthsComboBox"
                          Height="35"
                          Margin="5"/>

                <TextBlock Text="Стоимость автомобиля:"
                           FontSize="15"
                           Margin="5,20,5,5"/>

                <TextBlock x:Name="TotalPriceText"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="5"/>

                <TextBlock x:Name="LoanAmountText"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="5,15,5,5"/>

                <TextBlock Text="Процентная ставка: 12% годовых"
                           FontSize="15"
                           Margin="5,15,5,20"/>

                <TextBlock x:Name="MonthlyPaymentText"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="DarkGreen"
                           TextWrapping="Wrap"
                           Margin="5,20"/>

            </StackPanel>
        </Grid>

    </ScrollViewer>
</Page>
