<Window x:Class="WpfApp10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоконфигуратор"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Автоконфигуратор"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Создайте автомобиль своей мечты"
                       FontSize="15"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="StepTitle"
                       Text="Шаг 1 из 5 — Выбор автомобиля"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <ProgressBar x:Name="WizardProgress"
                         Minimum="1"
                         Maximum="5"
                         Value="1"
                         Height="8"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="25"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <Grid x:Name="StepContent">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Добро пожаловать!"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Здесь появятся настройки вашего автомобиля"
                               FontSize="15"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Grid>

        </Border>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="1"
                    Content="Назад"
                    IsEnabled="False"
                    Background="#6B7280"
                    MinWidth="110"/>

            <Button x:Name="NextButton"
                    Grid.Column="2"
                    Content="Далее"
                    MinWidth="110"/>
        </Grid>

    </Grid>
</Window>