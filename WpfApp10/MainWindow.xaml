<Window x:Class="WpfApp10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоконфигуратор"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Автоконфигуратор"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StepTitle"
                       Text="Шаг 1 из 5 — Выбор автомобиля"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <ProgressBar x:Name="WizardProgress"
                         Minimum="1"
                         Maximum="5"
                         Value="1"
                         Height="8"/>
        </StackPanel>

        <StackPanel x:Name="StepContent"
                    Grid.Row="2"
                    Margin="0,30,0,0"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button x:Name="BackButton"
                    Content="Назад"
                    IsEnabled="False"
                    Width="100"/>

            <Button x:Name="NextButton"
                    Content="Далее"
                    Width="100"/>

        </StackPanel>
    </Grid>
</Window>