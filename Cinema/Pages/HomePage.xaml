<Page x:Class="Cinema.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">

    <Grid Background="#F2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="25">
           <TextBlock Text="Афиша кинотеатра"
           FontSize="30"
           FontWeight="Bold"/>

            <TextBlock Text="Выберите фильм и забронируйте билеты"
                   FontSize="16"
                   Foreground="Gray"
                   Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                Width="300"
                Height="35"
                Margin="0,0,15,0"/>
                <ComboBox x:Name="SortBox"
                    Width="180"
                    Height="35"
                    IsEditable="True"
                    IsReadOnly="True"   
                    Text="Сортировка">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="По рейтингу"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MoviesList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Width="200"
                                Margin="10"
                                Padding="10"
                                Background="White"
                                CornerRadius="10">

                            <StackPanel>

                                <Image Height="230"
                                   Source="{Binding ImagePath}"
                                   Stretch="UniformToFill"/>

                                <TextBlock Text="{Binding Name}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,10,0,5"/>

                                <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"
                                    FontSize="14"/>

                                 <TextBlock Text="{Binding AgeRating, StringFormat=Возраст: {0}}"
                                    FontSize="14"/>

                                 <TextBlock Text="{Binding Genre}"
                                       FontSize="13"
                                       Foreground="Gray"
                                       Margin="0,5,0,0"/>

                                <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                            </StackPanel>


                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>
    </Grid>
</Page>
