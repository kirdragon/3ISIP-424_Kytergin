<Page x:Class="Cinema.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">

    <Grid Background="#F2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="25">
           <TextBlock Text="Афиша кинотеатра"
           FontSize="30"
           FontWeight="Bold"/>

            <TextBlock Text="Выберите фильм и забронируйте билеты"
                   FontSize="16"
                   Foreground="Gray"
                   Margin="0,5,0,20"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox"
                Width="300"
                Height="35"
                Margin="0,0,15,0"/>
                <ComboBox x:Name="SortBox"
                    Width="180"
                    Height="35"
                    IsEditable="True"
                    IsReadOnly="True"
                    Text="Сортировка">
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="По рейтингу"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

    </Grid>
</Page>
